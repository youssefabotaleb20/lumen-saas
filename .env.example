# Required in production: 32+ random characters (openssl rand -base64 32)
SESSION_PASSWORD=

# Public URL used for canonical links, the sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test mode). Leave empty to run with billing switched off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GitHub OAuth app. Leave empty to offer only the demo account.
# Callback URL: <your site>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
